# ---- App ----
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Seeded on first boot if no admin exists (admins cannot self-register)
ADMIN_EMAIL=admin@expanders360.com
ADMIN_PASSWORD=Admin12345!

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=expanders360
# Auto-create tables from entities. Use migrations in production.
DB_SYNCHRONIZE=true

# ---- MongoDB ----
MONGO_URI=mongodb://mongo:27017/expanders360

# ---- Email ----
# Leave SMTP_HOST empty to use the mock mailer (emails are logged, not sent).
# docker-compose ships MailHog: SMTP_HOST=mailhog, UI at http://localhost:8025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Expanders360 <no-reply@expanders360.com>"

# ---- Scheduler ----
ENABLE_SCHEDULER=true
