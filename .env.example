# ---- App ----
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Seeded on first boot if no admin exists (admins cannot self-register)
ADMIN_EMAIL=admin@expanders360.com
ADMIN_PASSWORD=Admin12345!

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=expanders360
# Auto-create tables from entities. Use migrations in production.
DB_SYNCHRONIZE=true

# ---- MongoDB ----
MONGO_URI=mongodb://mongo:27017/expanders360

# ---- Mail (@nestjs/mail) ----
# MAIL_TRANSPORT: log (mock, default: only logs) | file (.eml files in MAIL_DIRECTORY) | smtp
MAIL_TRANSPORT=smtp
MAIL_FROM="Expanders360 <no-reply@expanders360.com>"
# MAIL_DIRECTORY=var/mail
# smtp: docker-compose ships MailHog (UI: http://localhost:8025). It has no TLS, hence STARTTLS=never.
# For a real provider keep SMTP_STARTTLS unset (defaults to "required") and set SMTP_USER / SMTP_PASS.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_STARTTLS=never
SMTP_USER=
SMTP_PASS=

# ---- Scheduler ----
ENABLE_SCHEDULER=true
